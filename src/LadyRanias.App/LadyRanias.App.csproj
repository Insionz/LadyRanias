<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Under utvikling: dotnet run starter Vite (npm run dev) automatisk hvis den ikke allerede kjører. -->
  <PropertyGroup>
    <SpaRoot>ClientApp\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <UserSecretsId>4f820105-a191-41bf-9525-1a0100a726b6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.14" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.17.0" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup>
	<InternalsVisibleTo Include="LadyRanias.Tests" />
  </ItemGroup>

  <!--
    Ved dotnet publish: bygg React-appen og ta med filene i publiseringen.
    Vite legger filene i wwwroot (se outDir i vite.config.ts). Siden de lages underveis i publiseringen,
    må vi legge dem til listen over filer som skal publiseres selv.
  -->
  <Target Name="PublishClientApp" AfterTargets="ComputeFilesToPublish">
	<Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" Condition="'$(SkipClientBuild)' != 'true'" />
	<Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" Condition="'$(SkipClientBuild)' != 'true'" />

    <ItemGroup>
      <ClientDistFiles Include="wwwroot\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(ClientDistFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
