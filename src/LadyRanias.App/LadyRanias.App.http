@LadyRanias.App_HostAddress = http://localhost:5127

@host = {{LadyRanias.App_HostAddress}}

### Opprett en katt
# @name createCat
POST {{host}}/api/admin/cats
Content-Type: application/json

{
  "name": "Kiara",
  "sex": "Female",
  "birthDate": "2024-03-01",
  "description": "Sibirsk skogkatt"
}

### Hent alle (offentlig)
GET {{host}}/api/public/cats

### Hent den vi nettopp opprettet
GET {{host}}/api/public/cats/{{createCat.response.body.$.id}}

### Last opp bilde (bytt ut stien med et ekte bilde)
# @name uploadImage
POST {{host}}/api/admin/cats/{{createCat.response.body.$.id}}/images
Content-Type: multipart/form-data; boundary=grense

--grense
Content-Disposition: form-data; name="formFile"; filename="kiara.jpg"
Content-Type: image/jpeg

< C:\Users\insio\Pictures\kiara.jpg
--grense--

### Liste over bildene til katten
GET {{host}}/api/public/cats/{{createCat.response.body.$.id}}/images

### Miniatyr (åpne også adressen i nettleseren for å se bildet)
GET {{host}}/api/public/cats/{{createCat.response.body.$.id}}/images/{{uploadImage.response.body.$.imageId}}?size=thumb

### Stort bilde
GET {{host}}/api/public/cats/{{createCat.response.body.$.id}}/images/{{uploadImage.response.body.$.imageId}}?size=large

### Slett bildet
DELETE {{host}}/api/admin/cats/{{createCat.response.body.$.id}}/images/{{uploadImage.response.body.$.imageId}}

### Slett katten (sletter også bildene)
DELETE {{host}}/api/admin/cats/{{createCat.response.body.$.id}}

### ---------- Kull og kattunger ----------

### Mor
# @name createMother
POST {{host}}/api/admin/cats
Content-Type: application/json

{
  "name": "Kiara",
  "sex": "Female",
  "birthDate": "2022-03-01",
  "description": "Mor til A-kullet"
}

### Far
# @name createFather
POST {{host}}/api/admin/cats
Content-Type: application/json

{
  "name": "Børre",
  "sex": "Male",
  "birthDate": "2021-05-01",
  "description": "Far til A-kullet"
}

### Planlagt kull
# @name createLitter
POST {{host}}/api/admin/litters
Content-Type: application/json

{
  "name": "A-kullet",
  "motherId": "{{createMother.response.body.$.id}}",
  "fatherId": "{{createFather.response.body.$.id}}",
  "expectedDate": "2026-12-15",
  "description": "Vårt første kull"
}

### Kattunge før fødsel (skal gi 409)
POST {{host}}/api/admin/litters/{{createLitter.response.body.$.id}}/kittens
Content-Type: application/json

{ "name": "Ask", "sex": "Male" }

### Kullet er født
POST {{host}}/api/admin/litters/{{createLitter.response.body.$.id}}/born
Content-Type: application/json

{ "birthDate": "2026-11-01" }

### Kattunge
# @name createKitten
POST {{host}}/api/admin/litters/{{createLitter.response.body.$.id}}/kittens
Content-Type: application/json

{ "name": "Ask", "sex": "Male", "description": "Rolig og nysgjerrig" }

### Reserver
PUT {{host}}/api/admin/litters/{{createLitter.response.body.$.id}}/kittens/{{createKitten.response.body.$.id}}/status
Content-Type: application/json

{ "status": "Reserved" }

### Selg
PUT {{host}}/api/admin/litters/{{createLitter.response.body.$.id}}/kittens/{{createKitten.response.body.$.id}}/status
Content-Type: application/json

{ "status": "Sold" }

### Reserver en solgt kattunge (skal gi 409)
PUT {{host}}/api/admin/litters/{{createLitter.response.body.$.id}}/kittens/{{createKitten.response.body.$.id}}/status
Content-Type: application/json

{ "status": "Reserved" }

### Alle kull (offentlig)
GET {{host}}/api/public/litters

### Slett kullet (sletter også kattungene)
DELETE {{host}}/api/admin/litters/{{createLitter.response.body.$.id}}

### ---------- Kontaktskjema ----------

### Send kontaktmelding (skal gi 202)
POST {{host}}/api/public/contact
Content-Type: application/json

{
  "name": "Kari",
  "email": "kari@example.com",
  "phone": "900 00 000",
  "subject": "Kull våren 2027",
  "message": "Har dere kattunger til våren?"
}

### Ugyldig e-post og for kort melding (skal gi 400 med forklaring)
POST {{host}}/api/public/contact
Content-Type: application/json

{
  "name": "Kari",
  "email": "ikke-en-epost",
  "message": "Hei"
}
